{
	"schemaVersion": 1,
	"id": "arknights-origin",
	"version": "${version}",
	"name": "Arknights-Origin",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/arknights_origin/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "reimu.arknights_origin.ArknightsOrigin"
		],
		"client": [
          "reimu.arknights_origin.ArknightsOriginClient"
		],
		"fabric-datagen": [
			"reimu.arknights_origin.ArknightsOriginDataGenerator"
		]
	},
	"mixins": [
      "arknights-origin.mixins.json",
		{
			"config": "arknights-origin.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.1",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}